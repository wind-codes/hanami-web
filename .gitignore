# ── HANAMI WEB · .gitignore ──────────────────────────
# Static site — source files only, no build cache.

# OS / editor cruft
.DS_Store
Thumbs.db
.desktop
*.lnk

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log

# Node (in case dependencies are added later)
node_modules/
package-lock.json

# Build output (none currently, but future-proof)
dist/
.git/

# Secrets
.env
.env.local
*.key